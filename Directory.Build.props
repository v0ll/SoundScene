<Project>

  <!--
    Shared MSBuild settings for every project in the repository.
    MSBuild imports this file automatically; do not reference it from individual .csproj files.
    Keep TargetFramework out of here - projects legitimately differ (net10.0 vs net10.0-windows).
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Code quality. Warnings are errors so CI and local builds agree. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Reproducible builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Package / assembly metadata -->
  <PropertyGroup>
    <VersionPrefix>0.2.1</VersionPrefix>
    <Product>SoundScene</Product>
    <Authors>Ali Eren Altuntas</Authors>
    <Company>SoundScene</Company>
    <Copyright>Copyright (c) 2026 Ali Eren Altuntas</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Tests and samples should never end up on a feed. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.Spike'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
