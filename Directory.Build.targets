<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Copies the native bridge next to every managed assembly that might load it.
    The bridge is built out-of-band by CMake, so this target is a no-op until
    someone has run a native build.
  -->
  <PropertyGroup>
    <!-- Visual Studio generators put the DLL in a per-configuration folder;
         Ninja and other single-config generators put it beside the cache. -->
    <NativeBridgePath Condition="Exists('$(MSBuildThisFileDirectory)native\build\Release\SoundScene.DaxBridge.dll')">$(MSBuildThisFileDirectory)native\build\Release\SoundScene.DaxBridge.dll</NativeBridgePath>
    <NativeBridgePath Condition="'$(NativeBridgePath)' == '' And Exists('$(MSBuildThisFileDirectory)native\build\SoundScene.DaxBridge.dll')">$(MSBuildThisFileDirectory)native\build\SoundScene.DaxBridge.dll</NativeBridgePath>
  </PropertyGroup>

  <Target Name="CopyNativeDaxBridge" AfterTargets="Build" Condition="Exists('$(NativeBridgePath)')">
    <Copy SourceFiles="$(NativeBridgePath)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'$(OutDir)' != ''" />
  </Target>

  <!--
    Publish copies the build output it knows about, and the bridge is not an
    item, so it has to be placed in the publish folder explicitly. Without this
    a published app starts but cannot open DAX.
  -->
  <Target Name="CopyNativeDaxBridgeToPublish"
          AfterTargets="Publish"
          Condition="Exists('$(NativeBridgePath)') And '$(PublishDir)' != ''">
    <Copy SourceFiles="$(NativeBridgePath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
