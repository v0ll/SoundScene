# Normalize line endings in the repository to LF, regardless of OS.
* text=auto eol=lf

# Source
*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.sln     text
*.json    text
*.md      text
*.yml     text
*.yaml    text
*.ps1     text

# Native / interop
*.c       text
*.h       text
*.cpp     text
*.hpp     text
*.idl     text
*.def     text
CMakeLists.txt text

# Windows command scripts must keep CRLF or cmd.exe misbehaves.
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary - never touch
*.png     binary
*.jpg     binary
*.ico     binary
*.dll     binary
*.exe     binary
*.lib     binary
*.pdb     binary
*.winmd   binary
*.nupkg   binary

# Don't diff or export vendored/generated content
*.generated.cs linguist-generated=true
