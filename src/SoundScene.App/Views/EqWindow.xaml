<Window x:Class="SoundScene.App.Views.EqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equalizer"
        Width="1020"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <!-- Slim track, ring thumb: closer to Dolby's own equalizer than the
             stock WPF slider, and it does not need a fill. -->
        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="8" />
            <Setter Property="LargeChange" Value="32" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Width="3"
                                    CornerRadius="1.5"
                                    Background="#3A3A44"
                                    HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22" Background="Transparent">
                                                    <Ellipse Width="18"
                                                             Height="18"
                                                             Fill="#1B1B1F"
                                                             Stroke="{StaticResource ActiveBrush}"
                                                             StrokeThickness="3.5" />
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="{StaticResource ActiveBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EqValueBox" TargetType="TextBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#141418" />
            <Setter Property="BorderBrush" Value="#2A2A31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource ActiveBrush}" />
            <Setter Property="ToolTip" Value="Type a level in dB" />
        </Style>

        <Style x:Key="AxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="16,7"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="22">
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="Transparent"
                                    BorderBrush="#6F6F7A"
                                    BorderThickness="1.5" />
                            <Ellipse x:Name="Thumb"
                                     Width="13"
                                     Height="13"
                                     Fill="#8A8A93"
                                     HorizontalAlignment="Left"
                                     Margin="5,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ActiveBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#08131A" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Custom EQ"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Dolby stores this curve on Personalize, so it is active while you edit. Changes apply instantly."
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#142A33"
                    CornerRadius="10"
                    Padding="10,3"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding RangeLabel}"
                           FontSize="10"
                           Foreground="{StaticResource ActiveBrush}" />
            </Border>
        </Grid>

        <TabControl Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,14,0,0">
            <TabItem Header="Equalizer" Style="{StaticResource TabHeader}">
                <StackPanel Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Canvas Width="44"
                                Height="250"
                                VerticalAlignment="Top"
                                Margin="0,28,0,0">
                            <TextBlock Text="12 dB" Canvas.Top="0" Style="{StaticResource AxisLabel}" />
                            <TextBlock Text="6 dB" Canvas.Top="55" Style="{StaticResource AxisLabel}" />
                            <TextBlock Text="0 dB" Canvas.Top="111" Style="{StaticResource AxisLabel}" />
                            <TextBlock Text="-6 dB" Canvas.Top="167" Style="{StaticResource AxisLabel}" />
                            <TextBlock Text="-12 dB" Canvas.Top="223" Style="{StaticResource AxisLabel}" />
                        </Canvas>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" ToolTip="{Binding Members}">
                                        <TextBox Style="{StaticResource EqValueBox}"
                                                 Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 KeyDown="OnValueKeyDown"
                                                 AutomationProperties.Name="{Binding Members}" />
                                        <Slider Style="{StaticResource EqSlider}"
                                                Height="250"
                                                Minimum="{Binding Minimum}"
                                                Maximum="{Binding Maximum}"
                                                Value="{Binding Value, Mode=TwoWay}"
                                                ToolTip="{Binding Members}" />
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Surround virtualizer"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource SwitchBox}"
                                          IsChecked="{Binding SurroundVirtualizer, Mode=TwoWay}"
                                          AutomationProperties.Name="Surround virtualizer" />
                                <TextBlock Text="{Binding SurroundVirtualizerText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="9,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Volume leveler"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource SwitchBox}"
                                          IsChecked="{Binding VolumeLeveler, Mode=TwoWay}"
                                          AutomationProperties.Name="Volume leveler" />
                                <TextBlock Text="{Binding VolumeLevelerText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="9,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Each slider moves a pair of neighbouring bands. The Advanced tab has all 20 individually."
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,16,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced" Style="{StaticResource TabHeader}">
                <StackPanel Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="20" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="1,0">
                                    <TextBox Style="{StaticResource EqValueBox}"
                                             Width="40"
                                             Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="OnValueKeyDown"
                                             AutomationProperties.Name="{Binding FrequencyLabel}" />
                                    <Slider Style="{StaticResource EqSlider}"
                                            Height="200"
                                            Minimum="{Binding Minimum}"
                                            Maximum="{Binding Maximum}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            ToolTip="{Binding FrequencyLabel}" />
                                    <TextBlock Text="{Binding FrequencyLabel}"
                                               FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="All 20 driver bands at Dolby's own frequencies. Type a level or drag a slider - no Apply needed."
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,14,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Status}"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="2,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Reset to flat"
                        Style="{StaticResource GhostButton}"
                        Padding="10,5"
                        Command="{Binding ResetCommand}" />
                <Button Content="Reload from Dolby"
                        Style="{StaticResource GhostButton}"
                        Padding="10,5"
                        Margin="8,0,0,0"
                        Command="{Binding ReloadCommand}" />
                <Button Content="Close"
                        Style="{StaticResource DialogButton}"
                        Margin="12,0,0,0"
                        IsCancel="True"
                        Click="OnClose" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
