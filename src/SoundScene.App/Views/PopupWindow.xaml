<Window x:Class="SoundScene.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundScene"
        Width="330"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="14"
            Margin="14"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="4,0,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SoundScene"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="EQ"
                            Style="{StaticResource GhostButton}"
                            Padding="9,2"
                            FontSize="10"
                            Margin="0,0,8,0"
                            ToolTip="Open the graphic equalizer"
                            Click="OnEqualizerClick" />
                    <TextBlock Text="{Binding BackendName}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ProfileButton}" Command="{Binding Command}">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#141418" CornerRadius="6" Margin="4,10,4,2" Padding="8,6">
                <TextBlock Text="{Binding Status}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Margin="4,14,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scenes"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Content="+ Save current"
                        Command="{Binding CaptureSceneCommand}" />
            </Grid>

            <TextBlock Text="Save the profile and EQ you like, then recall it in one click."
                       FontSize="10"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="6,6,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Scenes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer MaxHeight="190"
                          Margin="0,4,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource TileBrush}"
                                    CornerRadius="8"
                                    Margin="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource SceneButton}"
                                            Command="{Binding ApplyCommand}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource SceneDeleteButton}"
                                            Command="{Binding DeleteCommand}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
