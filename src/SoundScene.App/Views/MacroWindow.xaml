<Window x:Class="SoundScene.App.Views.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkeys"
        Width="640"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Hotkeys"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Bind a key combination to a profile, or to a toggle between two. Changes take effect as soon as you save."
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="+ Add hotkey"
                            Style="{StaticResource GhostButton}"
                            Padding="10,5"
                            Click="OnAdd" />
                    <Button x:Name="RemoveButton"
                            Content="Remove"
                            Style="{StaticResource GhostButton}"
                            Padding="10,5"
                            Margin="8,0,0,0"
                            Click="OnRemove" />
                </StackPanel>

                <ListBox x:Name="MacroList"
                         Background="#141418"
                         BorderBrush="#2A2A31"
                         BorderThickness="1"
                         Foreground="{StaticResource TextBrush}"
                         SelectionChanged="OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#142A33" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding GestureLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding ActionLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel x:Name="EditorPanel" Grid.Column="2">
                <TextBlock Text="Key combination"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="2,0,0,4" />

                <Border x:Name="CaptureBox"
                        Background="#141418"
                        BorderBrush="#3A3A44"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Focusable="True"
                        Cursor="Hand"
                        PreviewKeyDown="OnCaptureKeyDown"
                        MouseLeftButtonDown="OnCaptureClick">
                    <TextBlock x:Name="GestureText"
                               Text="Click here, then press keys"
                               FontSize="15"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" />
                </Border>

                <TextBlock x:Name="HintText"
                           FontSize="11"
                           Foreground="#FF8A8A"
                           TextWrapping="Wrap"
                           Margin="2,6,0,0"
                           Text="" />

                <TextBlock Text="When pressed"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="2,14,0,4" />
                <ComboBox x:Name="ActionCombo"
                          Padding="8,6"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Action"
                          SelectionChanged="OnActionChanged" />

                <StackPanel x:Name="SingleProfilePanel" Margin="0,10,0,0">
                    <TextBlock Text="Profile"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,4" />
                    <ComboBox x:Name="ProfileCombo"
                              Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Profile"
                              SelectionChanged="OnEditorChanged" />
                </StackPanel>

                <Grid x:Name="ToggleProfilePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="From"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,4" />
                    <TextBlock Grid.Column="2"
                               Text="To"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,4" />

                    <ComboBox x:Name="ProfileACombo"
                              Grid.Row="1"
                              Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Profile"
                              SelectionChanged="OnEditorChanged" />
                    <ComboBox x:Name="ProfileBCombo"
                              Grid.Row="1"
                              Grid.Column="2"
                              Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Profile"
                              SelectionChanged="OnEditorChanged" />
                </Grid>

                <CheckBox x:Name="EnabledCheck"
                          Content="Enabled"
                          Foreground="{StaticResource TextBrush}"
                          Margin="2,14,0,0"
                          Checked="OnEditorChanged"
                          Unchecked="OnEditorChanged" />

                <TextBlock x:Name="PreviewText"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="2,10,0,0"
                           Text="" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="2,0,12,0"
                       Text="" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="Save"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
